{
  "name": "laser-chess",
  "version": "2.0.0",
  "private": true,
  "description": "Online multiplayer Laser Chess (Khet-style) — Next.js + TypeScript",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false server.mts",
    "build": "next build",
    "start": "cross-env NODE_ENV=production tsx server.mts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cross-env": "^7.0.3",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "puppeteer-core": "^25.5.0",
    "typescript": "^5.7.3"
  }
}
